    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function parseQualificationOutput(text) {\n  const qualified = /not qualified/i.test(text) === false && /qualified/i.test(text);\n\n  const reasoningMatch = text.match(/\\*\\*Reasoning:\\*\\*\\s*([\\s\\S]*?)\\*\\*Next step:\\*\\*/i);\n  const reasoning = reasoningMatch\n    ? reasoningMatch[1]\n        .split('\\n')\n        .map(line => line.replace(/^[-•\\s]+/, '').trim())\n        .filter(Boolean)\n        .join(' ')\n    : '';\n\n  const nextStepMatch = text.match(/\\*\\*Next step:\\*\\*\\s*([\\s\\S]*)/i);\n  const next_step = nextStepMatch ? nextStepMatch[1].trim() : '';\n\n  return { qualified, reasoning, next_step };\n}\n\n// Pull the actual text from the AI Agent node's output\nconst raw = $input.item.json.output;\n\nreturn parseQualificationOutput(raw);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
