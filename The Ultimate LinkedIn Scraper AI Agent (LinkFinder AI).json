    {
      "parameters": {
        "jsCode": "function parseProfileOutput(text) {\n  const result = {};\n\n  // First bold line at the top = the person's name\n  const nameMatch = text.match(/^\\*\\*(.+?)\\*\\*/m);\n  result.full_name = nameMatch ? nameMatch[1].trim() : null;\n\n  // Match lines like: - **Label**: value\n  const lines = text.split('\\n');\n  for (const line of lines) {\n    const fieldMatch = line.match(/^-?\\s*\\*\\*(.+?)\\*\\*:\\s*(.+)$/);\n    if (!fieldMatch) continue;\n\n    const label = fieldMatch[1].trim().toLowerCase().replace(/\\s+/g, '_');\n    const value = fieldMatch[2].trim();\n    result[label] = value;\n  }\n\n  // Anything mentioned as unavailable (e.g. \"No phone number...\") — capture as a note\n  const noteMatch = text.match(/No [^.\\n]+\\.(?:[^\\n]*)/);\n  if (noteMatch) {\n    result.note = noteMatch[0].trim();\n  }\n\n  return result;\n}\n\n// n8n Code node usage (\"Run Once for Each Item\"):\nconst raw = $input.item.json.output;\nreturn parseProfileOutput(raw);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ],
      "id": "10fd8d93-0f7a-44a6-8232-dad908ffef8d",
      "name": "Code in JavaScript"
    }
