    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function parseAgentOutput(text) {\n  const result = {};\n  const lines = text.split('\\n');\n  let currentKey = null;\n\n  for (let line of lines) {\n    // Top-level field: \"- **Label**: value\" or \"**Label**: value\"\n    const fieldMatch = line.match(/^-?\\s*\\*\\*(.+?)\\*\\*:\\s*(.*)$/);\n\n    if (fieldMatch) {\n      const label = fieldMatch[1].trim().toLowerCase().replace(/[\\s/]+/g, '_');\n      const value = fieldMatch[2].trim();\n      result[label] = value;\n      currentKey = label;\n      continue;\n    }\n\n    // Sub-bullet belonging to the current field (e.g. education/experience entries)\n    const subBulletMatch = line.match(/^\\s+-\\s+(.+)$/);\n    if (subBulletMatch && currentKey) {\n      const entry = subBulletMatch[1].trim();\n      result[currentKey] = result[currentKey]\n        ? `${result[currentKey]}; ${entry}`\n        : entry;\n    }\n  }\n\n  // Split combined \"email_phone\" field if the agent merged them\n  if (result.email_phone !== undefined) {\n    const combined = result.email_phone;\n    if (/not found/i.test(combined)) {\n      result.email = '';\n      result.phone = '';\n    } else {\n      result.email = combined;\n      result.phone = '';\n    }\n    delete result.email_phone;\n  }\n\n  return result;\n}\n\nconst raw = $input.item.json.output;\nreturn parseAgentOutput(raw);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ],
