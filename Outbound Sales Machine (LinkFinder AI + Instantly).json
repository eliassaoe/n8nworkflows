    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst lines = (data['Target Companies (one per line)'] || '')\n  .split('\\n')\n  .map(l => l.trim())\n  .filter(l => l.length > 0);\n\nreturn lines.map(company_name => ({\n  json: {\n    company_name,\n    department: data['Department'] || '',\n    seniority: data['Target Role / Seniority'],\n    offering: data[\"What You're Offering\"],\n    contacts_per_company: data['Contacts per Company']\n  }\n}));"
