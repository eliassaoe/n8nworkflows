    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short, specific, non-salesy cold outreach email in html to this person.\n\nName: {{ $json.full_name }}\nTitle: {{ $json.title }}\nCompany: {{ $json.company_name }}\nLinkedIn: {{ $json.linkedin_url }}\n\nWhat we're offering: {{ $json.offering }}\n\nKeep the email under 120 words. Reference their role and company specifically — no generic filler like \"I hope this finds you well\" or \"I came across your profile\". Tie the offering naturally to something relevant about their role or company. End with a clear, low-friction call to action (e.g. asking for 15 minutes, not demanding a meeting).",
        "hasOutputParser": true
      },
